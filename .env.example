# Qdrant Configuration
QDRANT_URL=http://localhost:6333  # Оставьте как есть для in-memory режима (без Docker)
QDRANT_API_KEY=  # Оставьте пустым для локального Qdrant, заполните для облачного

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Site Configuration
SITE_URL=https://udmtpp.ru
SITEMAP_URL=https://udmtpp.ru/sitemap.xml

# Embedding Model
EMBEDDING_MODEL=multilingual-e5-base

# RAG Configuration
TOP_K=5
CONFIDENCE_THRESHOLD=0.7
